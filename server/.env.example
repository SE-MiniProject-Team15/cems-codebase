NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/cems
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated IP/CIDRs for the trusted reverse proxy/ingress only.
# Leave blank when this server terminates TLS directly; never use * or trust all proxies.
TRUST_PROXY=
